DATABRICKS_CATALOG=fabric_multisource_poc
DATABRICKS_SCHEMA=banking_source
DATABRICKS_STORAGE_ACCOUNT=<storage-account-name>
DATABRICKS_STORAGE_CONTAINER=<container-name>

COSMOS_ACCOUNT_NAME=<cosmos-account-name>
COSMOS_DATABASE_NAME=banking_poc
COSMOS_ENDPOINT=<cosmos-account-endpoint>

FABRIC_DATABRICKS_MIRROR_NAME=databricks_bronze
FABRIC_COSMOS_MIRROR_NAME=cosmos_bronze
FABRIC_DATABRICKS_CONNECTION_ID=<fabric-databricks-connection-id>

{
  "name": "fabric-risk-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run build && npm test",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "fabric:validate": "node scripts/validate-config.mjs",
    "schema:check": "tsc -p rayfin/tsconfig.json && node scripts/check-schema.mjs",
    "fabric:deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Execute"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "1.36.2",
    "@microsoft/rayfin-client": "1.36.2",
    "@microsoft/rayfin-connector-fabric-graphql": "1.36.2",
    "@microsoft/rayfin-connectors": "1.36.2",
    "@microsoft/rayfin-core": "1.36.2",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@microsoft/rayfin-cli": "1.36.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@azure/msal-node": "7.2.2",
    "zod": "$zod",
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "license": "MIT"
}
